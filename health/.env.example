# 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
# 실제 키는 .env 에만 넣습니다. 이 파일에는 절대 넣지 않습니다.
# .env 는 커밋하지 않습니다 (.gitignore 처리됨).

# 게시판 등 REST API 기본 주소. 현재는 백엔드가 없어 비워 둡니다.
VITE_API_BASE_URL=

# 카카오맵 JavaScript 키 (헬스장 찾기용)
# 발급: https://developers.kakao.com  →  내 애플리케이션  →  앱 키  →  JavaScript 키
# 플랫폼 > Web 에 http://localhost:3000 을 등록해야 동작합니다.
VITE_KAKAO_MAP_KEY=

# 식약처 식품영양성분 DB 인증키 (음식 검색 보강용)
# 발급: https://www.data.go.kr  →  식품의약품안전처_식품영양성분DB정보
VITE_FOOD_API_KEY=
