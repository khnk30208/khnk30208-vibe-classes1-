# 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
# 실제 키는 .env 에만 넣습니다. 이 파일에는 절대 넣지 않습니다.
# .env 는 커밋하지 않습니다 (.gitignore 처리됨).

# 게시판 등 REST API 기본 주소. 현재는 백엔드가 없어 비워 둡니다.
VITE_API_BASE_URL=

# 카카오맵 JavaScript 키 (헬스장 찾기)
#
# 1) https://developers.kakao.com 로그인 → 내 애플리케이션 → 애플리케이션 추가
# 2) 앱 설정 > 앱 키 → "JavaScript 키" 를 복사 (REST API 키가 아닙니다)
# 3) 앱 설정 > 플랫폼 > Web → 사이트 도메인에 개발 주소를 등록
#      http://localhost:3000   (vite.config.js 기본 포트)
#      http://localhost:3002   (.claude/launch.json 이 쓰는 포트)
#    도메인을 등록하지 않으면 SDK 로딩이 401 로 막힙니다.
# 4) 값을 채우고 dev 서버를 재시작하면 카카오 검색으로 자동 전환됩니다.
#
# 비워 두어도 동작합니다. 그때는 키가 필요 없는 OpenStreetMap Overpass 를 씁니다.
# 카카오 호출이 실패하면 자동으로 Overpass 로 되돌아갑니다.
VITE_KAKAO_MAP_KEY=

# 식약처 식품영양성분 DB 인증키 (음식 검색 보강용, 아직 미사용)
# 발급: https://www.data.go.kr  →  식품의약품안전처_식품영양성분DB정보
VITE_FOOD_API_KEY=
